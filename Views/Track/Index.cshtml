@using NexusServiceMarketingSystem.Models.Enums
@model NexusServiceMarketingSystem.Controllers.TrackViewModel
@{
    ViewData["Title"] = "Track order / account";
    string OrderBadge(OrderStatus s) => s switch
    {
        OrderStatus.Connected => "ok",
        OrderStatus.NotFeasible or OrderStatus.Cancelled => "bad",
        OrderStatus.Feasible => "ok",
        _ => "warn"
    };
    string ConnBadge(ConnectionStatus s) => s switch
    {
        ConnectionStatus.Active => "ok",
        ConnectionStatus.TemporarilyInactive => "warn",
        _ => "bad"
    };
}
<h1>Track order / account</h1>

<div class="nx-panel mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="orderNumber">Order number (11 characters)</label>
            <input id="orderNumber" name="orderNumber" value="@Model.OrderNumber" class="form-control" maxlength="11" placeholder="e.g. B0000000001" />
        </div>
        <div class="col-md-5">
            <label class="form-label" for="accountId">Account ID (16 characters)</label>
            <input id="accountId" name="accountId" value="@Model.AccountId" class="form-control" maxlength="16" placeholder="e.g. B001000000000001" />
        </div>
        <div class="col-md-2 d-grid"><button class="btn btn-primary">Search</button></div>
    </form>
</div>

@if (Model.OrderSearched)
{
    @if (Model.Order is null)
    {
        <div class="alert alert-warning">No order was found for <strong>@Model.OrderNumber</strong>. Check the number and try again.</div>
    }
    else
    {
        var o = Model.Order;
        <div class="nx-panel mb-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h2 class="mt-0 mb-1">Order @o.OrderNumber</h2>
                    <div class="text-muted">@o.ConnectionType.ToString() - @o.Plan.Name - @o.City.Name</div>
                </div>
                <span class="nx-badge @OrderBadge(o.Status)">@o.Status</span>
            </div>
            <dl class="row mt-3 mb-0">
                <dt class="col-sm-3">Placed on</dt><dd class="col-sm-9">@o.PlacedAtUtc.ToString("dd MMM yyyy")</dd>
                <dt class="col-sm-3">Last update</dt><dd class="col-sm-9">@o.StatusChangedAtUtc.ToString("dd MMM yyyy")</dd>
                <dt class="col-sm-3">Connections requested</dt><dd class="col-sm-9">@o.Quantity</dd>
            </dl>
            @if (o.FeasibilityChecks.Count > 0)
            {
                <h2>Feasibility</h2>
                <ul class="mb-0">
                    @foreach (var f in o.FeasibilityChecks.OrderBy(f => f.CheckType))
                    {
                        <li>@f.CheckType check: <strong>@f.Status</strong></li>
                    }
                </ul>
            }
            @if (o.Connections.Count > 0)
            {
                <h2>Connections created</h2>
                <ul class="mb-0">
                    @foreach (var c in o.Connections)
                    {
                        <li><a asp-action="Index" asp-route-accountId="@c.AccountId">@c.AccountId</a> - <span class="nx-badge @ConnBadge(c.Status)">@c.Status</span></li>
                    }
                </ul>
            }
        </div>
    }
}

@if (Model.AccountSearched)
{
    @if (Model.Connection is null)
    {
        <div class="alert alert-warning">No connection was found for <strong>@Model.AccountId</strong>. Check the account ID and try again.</div>
    }
    else
    {
        var c = Model.Connection;
        <div class="nx-panel mb-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h2 class="mt-0 mb-1">Account @c.AccountId</h2>
                    <div class="text-muted">@c.ConnectionType.ToString() - @c.Plan.Name - @c.City.Name</div>
                </div>
                <span class="nx-badge @ConnBadge(c.Status)">@c.Status</span>
            </div>
            <dl class="row mt-3 mb-0">
                <dt class="col-sm-3">Connected since</dt><dd class="col-sm-9">@c.ActivatedAtUtc.ToString("dd MMM yyyy")</dd>
                <dt class="col-sm-3">Status changed</dt><dd class="col-sm-9">@c.StatusChangedAtUtc.ToString("dd MMM yyyy")</dd>
                @if (Model.CanSeeAmounts)
                {
                    <dt class="col-sm-3">Total billed</dt><dd class="col-sm-9">@Model.TotalBilled.ToString("C")</dd>
                    <dt class="col-sm-3">Total paid</dt><dd class="col-sm-9">@Model.TotalPaid.ToString("C")</dd>
                    <dt class="col-sm-3">Amount due</dt><dd class="col-sm-9"><strong>@Model.AmountDue.ToString("C")</strong></dd>
                }
            </dl>
            @if (!Model.CanSeeAmounts)
            {
                <div class="alert alert-info mt-3 mb-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span>Billing amounts are visible only on your own accounts.</span>
                    }
                    else
                    {
                        <span><a asp-controller="Account" asp-action="Login">Sign in</a> to see the amount due on this account.</span>
                    }
                </div>
            }
        </div>
    }
}
