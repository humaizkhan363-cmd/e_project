@model NexusServiceMarketingSystem.Models.Workflows.CustomerRegistrationViewModel
@{ ViewData["Title"] = "Create Customer Account"; }
<h1>Create Customer Account</h1><p class="text-muted">Register to place orders and track your Nexus services.</p>
<form asp-action="Register" method="post" class="col-lg-7">@await Html.PartialAsync("_CustomerRegistrationFields", Model)<button class="btn btn-primary" type="submit">Create account</button> <a asp-action="Login" class="btn btn-link">Back to sign in</a></form>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
