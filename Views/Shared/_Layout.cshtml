@{
    string? role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool signedIn = User.Identity?.IsAuthenticated == true;
    string area = role switch
    {
        "Admin" => "Admin",
        "RetailStaff" => "Retail",
        "Technical" => "Technical",
        "Accounts" => "Accounts",
        "Customer" => "Customer",
        _ => ""
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexus Communications</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NexusServiceMarketingSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark nx-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">NEXUS <span>Communications</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nxNav" aria-controls="nxNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nxNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Catalog" asp-action="Plans">Plans</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Track" asp-action="Index">Track order / account</a></li>
                        @if (signedIn)
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="@area" asp-controller="Home" asp-action="Index">My Dashboard</a></li>
                        }
                        @if (role == "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Master data</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Cities" asp-action="Index">Cities</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="RetailShops" asp-action="Index">Retail shops</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Employees" asp-action="Index">Employees</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Plans" asp-action="Index">Plans</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="DiscountSchemes" asp-action="Index">Discount schemes</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Stock</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Vendors" asp-action="Index">Vendors</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Purchases" asp-action="Index">Purchases</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Operations</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Customers" asp-action="Index">Customers</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Operations" asp-action="Orders">Orders</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Operations" asp-action="Search">Advanced search</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Operations" asp-action="Reports">Reports</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Operations" asp-action="Feedback">Feedback</a></li>
                                </ul>
                            </li>
                        }
                        @if (role == "RetailStaff")
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Retail" asp-controller="Customers" asp-action="Index">Customers</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Retail" asp-controller="Orders" asp-action="Index">Orders</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Retail" asp-controller="Connections" asp-action="Index">Connections</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Retail" asp-controller="Payments" asp-action="Index">Collect payment</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Retail" asp-controller="Payments" asp-action="History">Payment history</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Search" asp-action="Index">Search</a></li>
                        }
                        @if (role == "Technical")
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Technical" asp-controller="Feasibility" asp-action="Index">Feasibility</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Technical" asp-controller="Connections" asp-action="Index">Connections</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Technical" asp-controller="Products" asp-action="Index">Equipment</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Search" asp-action="Index">Search</a></li>
                        }
                        @if (role == "Accounts")
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Accounts" asp-controller="Bills" asp-action="Index">Bills &amp; payments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Search" asp-action="Index">Search</a></li>
                        }
                        @if (role == "Customer")
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Customer" asp-controller="Orders" asp-action="Index">Orders</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Customer" asp-controller="Portal" asp-action="Connections">Connections</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Customer" asp-controller="Portal" asp-action="Bills">Bills</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Customer" asp-controller="Documents" asp-action="Index" asp-route-customerId="@User.FindFirst("NexusCustomerId")?.Value">Documents</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Customer" asp-controller="Portal" asp-action="Feedback">Feedback</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        @if (signedIn)
                        {
                            <li class="nav-item"><span class="nav-link nx-user">@User.FindFirst("NexusDisplayName")?.Value (@role)</span></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="btn btn-sm btn-light ms-lg-2" asp-area="" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 Nexus Communications - Telephone &amp; Internet Services - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
