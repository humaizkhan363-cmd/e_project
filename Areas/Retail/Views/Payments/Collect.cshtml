@model NexusServiceMarketingSystem.Models.Workflows.PaymentFormViewModel
<h1>Collect payment</h1><p>@Model.CustomerName · @Model.AccountId · bill #@Model.BillId</p><p>Total @Model.TotalAmount · Paid @Model.AmountPaid · Balance @Model.OutstandingAmount</p><form asp-action="Collect" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="BillId" type="hidden"/><label asp-for="Amount"></label><input asp-for="Amount" max="@Model.OutstandingAmount" class="form-control"/><label asp-for="Method"></label><select asp-for="Method" asp-items="Html.GetEnumSelectList<NexusServiceMarketingSystem.Models.Enums.PaymentMethod>()" class="form-select"><option value="">Choose</option></select><label asp-for="Reference"></label><input asp-for="Reference" class="form-control"/><button class="btn btn-primary mt-3">Record payment</button></form>
