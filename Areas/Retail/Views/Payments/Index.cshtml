@model IReadOnlyList<NexusServiceMarketingSystem.Models.Workflows.BillListItemViewModel>
<h1>Collect customer payments</h1>@if(TempData["StatusMessage"] is string s){<div class="alert alert-success">@s</div>}<table class="table"><thead><tr><th>Customer</th><th>Account</th><th>Bill</th><th>Outstanding</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Bill.Connection.Customer.FullName</td><td>@x.Bill.Connection.AccountId</td><td>#@x.Bill.Id</td><td>@x.Outstanding</td><td>@x.DisplayStatus</td><td><a asp-action="Collect" asp-route-id="@x.Bill.Id">Collect payment</a></td></tr>}</tbody></table>
