@{
    ViewData["Title"] = "Retail Dashboard";
}
<h1>Retail Dashboard</h1>
<p class="text-muted">Welcome, @User.FindFirst("NexusDisplayName")?.Value. Register customers, place orders and collect payments for your shop.</p>
<div class="row row-cols-1 row-cols-md-3 g-3">
    <div class="col"><a class="nx-tile" asp-controller="Customers" asp-action="Index"><h5>Customers</h5><p>Create customer profiles and logins, search existing customers.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Orders" asp-action="Index"><h5>Orders</h5><p>Place new connection orders and follow their status.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Connections" asp-action="Index"><h5>Connections</h5><p>Connections provided so far with billed, paid and due amounts.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Payments" asp-action="Index"><h5>Collect payment</h5><p>Record full or partial payments against bills.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Payments" asp-action="History"><h5>Payment history</h5><p>Everything collected at your shop to date.</p></a></div>
    <div class="col"><a class="nx-tile" asp-area="" asp-controller="Catalog" asp-action="Plans"><h5>Plans & prices</h5><p>Plan details to explain to walk-in customers.</p></a></div>
</div>
