@model NexusServiceMarketingSystem.Models.Workflows.CustomerRegistrationViewModel
@{ ViewData["Title"] = "New Customer"; }
<h1>New Customer</h1><p class="text-muted">Create the customer profile and login, then continue to order placement.</p>
<form asp-action="Create" method="post" class="col-lg-7">@await Html.PartialAsync("_CustomerRegistrationFields", Model)<button class="btn btn-primary">Create customer</button> <a asp-action="Index" class="btn btn-link">Cancel</a></form>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
