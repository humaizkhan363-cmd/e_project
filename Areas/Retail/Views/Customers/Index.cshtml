@model List<NexusServiceMarketingSystem.Models.Entities.Customer>
@{ ViewData["Title"] = "Shop Customers"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Shop Customers</h1><a asp-action="Create" class="btn btn-primary">New customer</a></div>
@if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Name, email, or phone"/></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Customer</th><th>Contact</th><th>City</th><th>Orders</th><th></th></tr></thead><tbody>@foreach(var customer in Model){<tr><td>@customer.FullName</td><td>@customer.Phone<br/>@customer.Email</td><td>@customer.City.Name</td><td>@customer.Orders.Count</td><td><a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary">Details</a></td></tr>}</tbody></table></div>
