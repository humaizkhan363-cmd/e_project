@model NexusServiceMarketingSystem.Models.Entities.Order
<h1>Order @Model.OrderNumber</h1><p>@Model.Customer.FullName · @Model.ConnectionType · @Model.Plan.Name</p><p>Address: @Model.InstallationAddress, @Model.City.Name</p><p>Status: <strong>@Model.Status</strong></p><h2>Feasibility</h2><ul>@foreach(var c in Model.FeasibilityChecks){<li>@c.CheckType: @c.Status — @c.Remarks</li>}</ul><h2>Connections</h2><ul>@foreach(var c in Model.Connections){<li>@c.AccountId — @c.Status</li>}</ul><a asp-action="Index">Back</a>
