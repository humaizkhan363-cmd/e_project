@model IReadOnlyList<NexusServiceMarketingSystem.Models.Workflows.BillListItemViewModel>
<h1>My bills</h1><p>Payments are recorded at a Nexus retail shop or through Accounts. This portal shows balances and receipts.</p><table class="table"><thead><tr><th>Account</th><th>Period</th><th>Issued</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.Bill.Connection.AccountId</td><td>@b.Bill.PeriodStart – @b.Bill.PeriodEnd</td><td>@b.Bill.IssueDate</td><td>@b.Bill.TotalAmount</td><td>@b.AmountPaid</td><td>@b.Outstanding</td><td>@b.DisplayStatus</td></tr>}</tbody></table>
