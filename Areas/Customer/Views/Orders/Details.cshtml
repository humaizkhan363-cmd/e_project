@model NexusServiceMarketingSystem.Models.Entities.Order
@if(TempData["StatusMessage"] is string sm){<div class="alert alert-success">@sm</div>}@if(TempData["ErrorMessage"] is string em){<div class="alert alert-danger">@em</div>}
<h1>Order @Model.OrderNumber</h1><p>Status: <strong>@Model.Status</strong></p><p>@Model.ConnectionType · @Model.Plan.Name@if(Model.LandlinePlan is not null){<span> + new telephone line (@Model.LandlinePlan.Name)</span>}@if(Model.DiscountPercent>0){<span> · Bulk discount @Model.DiscountPercent.ToString("0.##")%</span>} · @Model.City.Name · @Model.InstallationAddress</p>
<h2>Feasibility progress</h2><table class="table"><thead><tr><th>Check</th><th>Status</th><th>Distance</th><th>Server capacity</th><th>Notes</th></tr></thead><tbody>@foreach(var c in Model.FeasibilityChecks){<tr><td>@c.CheckType</td><td>@c.Status</td><td>@c.DistanceKm</td><td>@c.ServerAvailable</td><td>@c.Remarks</td></tr>}</tbody></table>
<h2>Connections</h2><ul>@foreach(var c in Model.Connections){<li>@c.AccountId — @c.Status</li>}</ul>@if(Model.Status==NexusServiceMarketingSystem.Models.Enums.OrderStatus.Placed||Model.Status==NexusServiceMarketingSystem.Models.Enums.OrderStatus.UnderFeasibilityCheck||Model.Status==NexusServiceMarketingSystem.Models.Enums.OrderStatus.Feasible){<form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mb-3" onsubmit="return confirm('Cancel this order?');"><button class="btn btn-outline-danger">Cancel order</button></form>}
<a asp-action="Index">Back to orders</a>
