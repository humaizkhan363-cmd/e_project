@model NexusServiceMarketingSystem.Models.Workflows.BillGenerationViewModel
<h1>Generate bill</h1><p>Service tax (12.24%) is calculated by the billing service.</p><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="ConnectionId"></label><select asp-for="ConnectionId" asp-items="Model.Connections" class="form-select"><option value="">Choose connection</option></select>
<label asp-for="PeriodStart"></label><input asp-for="PeriodStart" class="form-control"/><label asp-for="PeriodEnd"></label><input asp-for="PeriodEnd" class="form-control"/><label asp-for="IssueDate"></label><input asp-for="IssueDate" class="form-control"/><label asp-for="DueDate"></label><input asp-for="DueDate" class="form-control"/><label asp-for="UsageCharge"></label><input asp-for="UsageCharge" class="form-control"/><label asp-for="ReplacementCharge"></label><input asp-for="ReplacementCharge" class="form-control"/><button class="btn btn-primary mt-3">Generate</button></form>
