@model IReadOnlyList<NexusServiceMarketingSystem.Models.Workflows.BillListItemViewModel>
<h1>Bills</h1><p><a class="btn btn-primary" asp-action="Create">Generate bill</a></p>@if(TempData["StatusMessage"] is string s){<div class="alert alert-success">@s</div>}
<table class="table"><thead><tr><th>Bill</th><th>Customer</th><th>Account</th><th>Period</th><th>Total</th><th>Paid</th><th>Outstanding</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>#@x.Bill.Id</td><td>@x.Bill.Connection.Customer.FullName</td><td>@x.Bill.Connection.AccountId</td><td>@x.Bill.PeriodStart - @x.Bill.PeriodEnd</td><td>@x.Bill.TotalAmount</td><td>@x.AmountPaid</td><td>@x.Outstanding</td><td>@x.DisplayStatus</td><td>@if(x.Outstanding>0){<a asp-action="Payment" asp-route-id="@x.Bill.Id">Record payment</a>}</td></tr>}</tbody></table>
