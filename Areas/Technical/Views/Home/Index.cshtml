@{
    ViewData["Title"] = "Technical Dashboard";
}
<h1>Technical Dashboard</h1>
<p class="text-muted">Welcome, @User.FindFirst("NexusDisplayName")?.Value. Work the feasibility queue, create connections and look after equipment.</p>
<div class="row row-cols-1 row-cols-md-3 g-3">
    <div class="col"><a class="nx-tile" asp-controller="Feasibility" asp-action="Index"><h5>Feasibility & orders</h5><p>Track orders, run landline / internet feasibility checks.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Connections" asp-action="Index"><h5>Connections</h5><p>Create connections from feasible orders; make them active or inactive.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Connections" asp-action="Overdue"><h5>Overdue bills</h5><p>Suspend connections with unpaid bills; reactivate them once paid.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Products" asp-action="Index"><h5>Equipment & stock</h5><p>Modems, routers and other equipment, stock levels and reorder alerts.</p></a></div>
    <div class="col"><a class="nx-tile" asp-area="" asp-controller="Track" asp-action="Index"><h5>Search status</h5><p>Look up an order number or account ID.</p></a></div>
</div>
