@{
    ViewData["Title"] = "Technical Dashboard";
}
<section class="nx-stage nx-pagehead" aria-labelledby="dash-title">
    <partial name="_NexusGlobe" />
    <span class="nx-eyebrow">Technical team</span>
    <h1 id="dash-title" data-split>Technical Dashboard</h1>
    <p>Welcome, @User.FindFirst("NexusDisplayName")?.Value. Work the feasibility queue, create connections and look after equipment.</p>
</section>
@await Component.InvokeAsync("DashboardStats")
<h2 class="nx-section-title">Quick actions</h2>
<div class="row row-cols-1 row-cols-md-3 g-3">
    <div class="col"><a class="nx-tile" asp-controller="Feasibility" asp-action="Index"><span class="nx-tile__ico">@Icons.Svg("radar")</span><h5>Feasibility & orders</h5><p>Track orders, run landline / internet feasibility checks.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Connections" asp-action="Index"><span class="nx-tile__ico">@Icons.Svg("plug")</span><h5>Connections</h5><p>Create connections from feasible orders; make them active or inactive.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Connections" asp-action="Overdue"><span class="nx-tile__ico">@Icons.Svg("alert")</span><h5>Overdue bills</h5><p>Suspend connections with unpaid bills; reactivate them once paid.</p></a></div>
    <div class="col"><a class="nx-tile" asp-controller="Products" asp-action="Index"><span class="nx-tile__ico">@Icons.Svg("wrench")</span><h5>Equipment & stock</h5><p>Modems, routers and other equipment, stock levels and reorder alerts.</p></a></div>
    <div class="col"><a class="nx-tile" asp-area="" asp-controller="Track" asp-action="Index"><span class="nx-tile__ico">@Icons.Svg("search")</span><h5>Search status</h5><p>Look up an order number or account ID.</p></a></div>
</div>
