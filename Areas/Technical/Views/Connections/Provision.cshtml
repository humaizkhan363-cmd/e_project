@model NexusServiceMarketingSystem.Models.Workflows.ConnectionProvisionViewModel
<h1>Provision order @Model.OrderNumber</h1><p>@Model.ConnectionType × @Model.Quantity</p><form asp-action="Provision" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="OrderId" type="hidden"/><label asp-for="ProductId"></label><select asp-for="ProductId" asp-items="Model.Products" class="form-select"><option value="">Choose equipment (internet orders)</option></select><label asp-for="SerialNumber"></label><input asp-for="SerialNumber" class="form-control"/><label asp-for="LandlineConnectionId"></label><select asp-for="LandlineConnectionId" asp-items="Model.Landlines" class="form-select"><option value="">Choose existing Nexus landline for dial-up</option></select><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" class="form-control"/><button class="btn btn-primary mt-3">Provision connections</button></form>
