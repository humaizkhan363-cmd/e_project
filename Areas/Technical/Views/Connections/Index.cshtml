@model IReadOnlyList<NexusServiceMarketingSystem.Models.Entities.Connection>
@{ var plans=(List<NexusServiceMarketingSystem.Models.Entities.Plan>)ViewBag.Plans; var products=(List<NexusServiceMarketingSystem.Models.Entities.Product>)ViewBag.Products; }
<h1>Connections</h1>
@if(TempData["StatusMessage"] is string s){<div class="alert alert-success">@s</div>}
@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
<p class="text-muted">Set a connection temporarily or permanently inactive, or move it to another plan of the same type. The security deposit is refundable when a connection is permanently closed.</p>
<table class="table align-middle">
<thead><tr><th>Account</th><th>Customer</th><th>Type</th><th>Plan</th><th>Status</th><th>Deposit</th><th>Order</th><th>Status update</th><th>Change plan</th><th>Replace spoiled equipment</th></tr></thead>
<tbody>
@foreach(var c in Model){
<tr>
<td>@c.AccountId</td><td>@c.Customer.FullName</td><td>@c.ConnectionType</td><td>@c.Plan.Name</td><td>@c.Status</td>
<td>@c.SecurityDepositAmount.ToString("C")@if(c.Status==NexusServiceMarketingSystem.Models.Enums.ConnectionStatus.PermanentlyInactive){<div class="small text-success">refundable</div>}</td>
<td>@c.Order.OrderNumber</td>
<td><form asp-action="ChangeStatus" method="post" class="d-flex gap-1"><input type="hidden" name="Id" value="@c.Id"/><select name="Status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<NexusServiceMarketingSystem.Models.Enums.ConnectionStatus>()"></select><button class="btn btn-sm btn-primary">Save</button></form></td>
<td>@if(c.Status!=NexusServiceMarketingSystem.Models.Enums.ConnectionStatus.PermanentlyInactive){<form asp-action="ChangePlan" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@c.Id"/><select name="planId" class="form-select form-select-sm">@foreach(var pl in plans.Where(x=>x.ConnectionType==c.ConnectionType)){<option value="@pl.Id" selected="@(pl.Id==c.PlanId)">@pl.Name</option>}</select><button class="btn btn-sm btn-outline-primary">Change</button></form>}</td>
<td>@if(c.ConnectionType!=NexusServiceMarketingSystem.Models.Enums.ConnectionType.Telephone&&c.Status!=NexusServiceMarketingSystem.Models.Enums.ConnectionStatus.PermanentlyInactive&&products.Count>0){<form asp-action="ReplaceEquipment" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@c.Id"/><select name="productId" class="form-select form-select-sm">@foreach(var pr in products){<option value="@pr.Id">@pr.Name - stock @pr.StockQuantity</option>}</select><input name="serialNumber" class="form-control form-control-sm" placeholder="Serial (optional)" maxlength="60"/><button class="btn btn-sm btn-outline-danger">Replace</button></form>}</td>
</tr>}
</tbody></table>
