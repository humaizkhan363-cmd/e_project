@model IReadOnlyList<NexusServiceMarketingSystem.Models.Entities.Feedback>
<h1>Customer feedback</h1><table class="table"><thead><tr><th>Date</th><th>Customer</th><th>Rating</th><th>Order</th><th>Comments</th></tr></thead><tbody>@foreach(var f in Model){<tr><td>@f.SubmittedAtUtc.ToLocalTime().ToString("g")</td><td>@f.Customer.FullName</td><td>@f.Rating / 5</td><td>@f.Order?.OrderNumber</td><td>@f.Comments</td></tr>}</tbody></table>
