@model IReadOnlyList<NexusServiceMarketingSystem.Models.Entities.Order>
<h1>All orders</h1><form method="get" class="row g-2 mb-3"><div class="col"><input name="term" value="@ViewBag.Term" placeholder="Order, customer, email or phone" class="form-control"/></div><div class="col"><select name="status" asp-items="Html.GetEnumSelectList<NexusServiceMarketingSystem.Models.Enums.OrderStatus>()" class="form-select"><option value="">All statuses</option></select></div><div class="col"><input name="from" type="date" value="@ViewBag.From" class="form-control"/></div><div class="col"><input name="through" type="date" value="@ViewBag.Through" class="form-control"/></div><button class="btn btn-primary col-auto">Search</button></form><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Type</th><th>Plan</th><th>City</th><th>Date</th><th>Status</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.OrderNumber</td><td>@o.Customer.FullName</td><td>@o.ConnectionType</td><td>@o.Plan.Name</td><td>@o.City.Name</td><td>@o.PlacedAtUtc.ToLocalTime().ToShortDateString()</td><td>@o.Status</td></tr>}</tbody></table>
