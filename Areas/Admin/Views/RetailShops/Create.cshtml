@model NexusServiceMarketingSystem.Areas.Admin.Models.RetailShopFormViewModel
@{ ViewData["Title"] = "New Retail Shop"; }
<h1>New Retail Shop</h1>
<form asp-action="Create" method="post" class="col-lg-7"><div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="AddressLine" class="form-label"></label><textarea asp-for="AddressLine" class="form-control" rows="2"></textarea><span asp-validation-for="AddressLine" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/><span asp-validation-for="Phone" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="CityId" class="form-label"></label><select asp-for="CityId" asp-items="Model.Cities" class="form-select"><option value="">Select a city</option></select><span asp-validation-for="CityId" class="text-danger"></span></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label"></label></div>
<button class="btn btn-primary" type="submit">Create shop</button> <a asp-action="Index" class="btn btn-link">Cancel</a></form>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
