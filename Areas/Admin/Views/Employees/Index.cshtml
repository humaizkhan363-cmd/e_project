@model List<NexusServiceMarketingSystem.Models.Entities.Employee>
@{ ViewData["Title"] = "Employees"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Employees</h1><a asp-action="Create" class="btn btn-primary">New employee</a></div>
@if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Retail shop</th><th>Login</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var employee in Model) { <tr><td>@employee.FullName</td><td>@employee.Email</td><td>@(employee.Role == NexusServiceMarketingSystem.Models.Enums.EmployeeRole.RetailStaff ? "Retail Employee" : employee.Role == NexusServiceMarketingSystem.Models.Enums.EmployeeRole.Technical ? "Technical Employee" : employee.Role == NexusServiceMarketingSystem.Models.Enums.EmployeeRole.Accounts ? "Accounts Employee" : "Admin")</td><td>@(employee.RetailShop is null ? "—" : employee.RetailShop.Name + " — " + employee.RetailShop.City.Name)</td><td>@(employee.User?.Username ?? "No login")</td><td><span class="badge @(employee.IsActive ? "bg-success" : "bg-secondary")">@(employee.IsActive ? "Active" : "Inactive")</span></td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-secondary">Details</a> <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary">Edit</a> <form asp-action="ToggleStatus" asp-route-id="@employee.Id" method="post" class="d-inline"><button class="btn btn-sm @(employee.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(employee.IsActive ? "Deactivate" : "Activate")</button></form></td></tr> }
</tbody></table></div>
