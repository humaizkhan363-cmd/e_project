@model NexusServiceMarketingSystem.Models.Entities.Employee
@{ ViewData["Title"] = "Employee Details"; string roleName = Model.Role switch { NexusServiceMarketingSystem.Models.Enums.EmployeeRole.RetailStaff => "Retail Employee", NexusServiceMarketingSystem.Models.Enums.EmployeeRole.Technical => "Technical Employee", NexusServiceMarketingSystem.Models.Enums.EmployeeRole.Accounts => "Accounts Employee", _ => "Admin" }; }
<h1>@Model.FullName</h1><p><span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span></p>
<dl class="row"><dt class="col-sm-3">Role</dt><dd class="col-sm-9">@roleName</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Retail shop</dt><dd class="col-sm-9">@(Model.RetailShop is null ? "—" : Model.RetailShop.Name + " — " + Model.RetailShop.City.Name)</dd><dt class="col-sm-3">Username</dt><dd class="col-sm-9">@(Model.User?.Username ?? "No login")</dd><dt class="col-sm-3">Created (UTC)</dt><dd class="col-sm-9">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit employee</a> <a asp-action="Index" class="btn btn-link">Back</a>
