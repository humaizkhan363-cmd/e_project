@model NexusServiceMarketingSystem.Areas.Admin.Models.PlanFormViewModel
@{ ViewData["Title"] = "New Plan"; }
<h1>New Plan</h1>
<p class="text-muted">Fill in only the fields that apply to the Connection Type / Kind you choose (Hourly needs Included Hours; Unlimited needs Speed; Landline plans need at least the local call rate). Unused fields are ignored and cleared automatically.</p>
<form asp-action="Create" method="post" class="col-md-7">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="row">
        <div class="col mb-3">
            <label asp-for="ConnectionType" class="form-label"></label>
            <select asp-for="ConnectionType" class="form-select" asp-items="Html.GetEnumSelectList<NexusServiceMarketingSystem.Models.Enums.ConnectionType>()"></select>
        </div>
        <div class="col mb-3">
            <label asp-for="Kind" class="form-label"></label>
            <select asp-for="Kind" class="form-select" asp-items="Html.GetEnumSelectList<NexusServiceMarketingSystem.Models.Enums.PlanKind>()"></select>
        </div>
    </div>
    <div class="row">
        <div class="col mb-3"><label asp-for="IncludedHours" class="form-label"></label><input asp-for="IncludedHours" class="form-control" /></div>
        <div class="col mb-3"><label asp-for="SpeedKbps" class="form-label"></label><input asp-for="SpeedKbps" class="form-control" /></div>
    </div>
    <div class="row">
        <div class="col mb-3"><label asp-for="ValidityMonths" class="form-label"></label><input asp-for="ValidityMonths" class="form-control" /></div>
        <div class="col mb-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" /></div>
        <div class="col mb-3"><label asp-for="SecurityDeposit" class="form-label"></label><input asp-for="SecurityDeposit" class="form-control" /></div>
    </div>
    <div class="row">
        <div class="col mb-3"><label asp-for="LocalCallRatePerMinute" class="form-label"></label><input asp-for="LocalCallRatePerMinute" class="form-control" /></div>
        <div class="col mb-3"><label asp-for="StdCallRatePerMinute" class="form-label"></label><input asp-for="StdCallRatePerMinute" class="form-control" /></div>
        <div class="col mb-3"><label asp-for="MobileMessagingRatePerMinute" class="form-label"></label><input asp-for="MobileMessagingRatePerMinute" class="form-control" /></div>
    </div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
