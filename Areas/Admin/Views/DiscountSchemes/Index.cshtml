@model List<NexusServiceMarketingSystem.Models.Entities.DiscountScheme>
@{ ViewData["Title"] = "Discount Schemes"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Discount Schemes</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Scheme</a>
</div>
@if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
<table class="table table-striped table-hover align-middle">
    <thead><tr><th>Name</th><th>Range</th><th>Discount</th><th>Applies To</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.MinConnections &ndash; @(s.MaxConnections?.ToString() ?? "no limit")</td>
                <td>@s.DiscountPercent%</td>
                <td>
                    @(s.AppliesToAdvance ? "Advance" : "")
                    @(s.AppliesToAdvance && s.AppliesToSecurityDeposit ? " + " : "")
                    @(s.AppliesToSecurityDeposit ? "Deposit" : "")
                </td>
                <td>
                    @if (s.IsActive) { <span class="badge bg-success">Active</span> }
                    else { <span class="badge bg-secondary">Inactive</span> }
                </td>
                <td><a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
            </tr>
        }
    </tbody>
</table>
