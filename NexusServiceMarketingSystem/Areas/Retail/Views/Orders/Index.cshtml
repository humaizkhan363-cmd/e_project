@model IReadOnlyList<NexusServiceMarketingSystem.Models.Entities.Order>
<h1>Shop orders</h1><p><a class="btn btn-primary" asp-action="Create">Place order</a></p>@if(TempData["StatusMessage"] is string s){<div class="alert alert-success">@s</div>}<table class="table"><thead><tr><th>Number</th><th>Customer</th><th>Service</th><th>Plan</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.OrderNumber</td><td>@o.Customer.FullName</td><td>@o.ConnectionType</td><td>@o.Plan.Name</td><td>@o.Status</td><td><a asp-action="Details" asp-route-id="@o.Id">Details</a></td></tr>}</tbody></table>
