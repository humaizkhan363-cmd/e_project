@model NexusServiceMarketingSystem.Models.Workflows.OrderFormViewModel
<h1>Place a customer order</h1><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="CustomerId"></label><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="">Choose customer</option></select><label asp-for="ConnectionType"></label><select asp-for="ConnectionType" asp-items="Model.ConnectionTypes" class="form-select"><option value="">Choose service</option></select><label asp-for="PlanId"></label><select asp-for="PlanId" asp-items="Model.Plans" class="form-select"><option value="">Choose plan</option></select><div id="landline-plan-group"><label asp-for="LandlinePlanId"></label><select asp-for="LandlinePlanId" asp-items="Model.LandlinePlans" class="form-select"><option value="">Customer already has a Nexus landline</option></select><div class="form-text">Dial-up needs a Nexus landline. If there is none, choose a landline plan: the telephone line and the dial-up are applied for together (both feasibility checks are run).</div></div>
<label asp-for="CityId"></label><select asp-for="CityId" asp-items="Model.Cities" class="form-select"><option value="">Choose city</option></select><label asp-for="InstallationAddress"></label><input asp-for="InstallationAddress" class="form-control"/><label asp-for="Quantity"></label><input asp-for="Quantity" class="form-control"/><button class="btn btn-primary mt-3">Place order</button></form>
<partial name="_OrderFormScript" />
