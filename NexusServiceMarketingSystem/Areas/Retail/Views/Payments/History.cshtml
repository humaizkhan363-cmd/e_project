@model List<NexusServiceMarketingSystem.Models.Entities.Payment>
@{ ViewData["Title"] = "Payment history"; }
<h1>Payments received at this shop</h1>
<div class="table-responsive"><table class="table table-hover align-middle">
<thead><tr><th>Date</th><th>Customer</th><th>Account ID</th><th>Bill</th><th>Method</th><th>Reference</th><th class="text-end">Amount</th></tr></thead>
<tbody>
@foreach (var p in Model)
{
    <tr><td>@p.PaidAtUtc.ToString("dd MMM yyyy HH:mm")</td><td>@p.Bill.Connection.Customer.FullName</td><td>@p.Bill.Connection.AccountId</td><td>#@p.BillId</td><td>@p.Method</td><td>@p.Reference</td><td class="text-end">@p.Amount.ToString("C")</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted">No payments have been recorded yet.</td></tr> }
</tbody></table></div>
