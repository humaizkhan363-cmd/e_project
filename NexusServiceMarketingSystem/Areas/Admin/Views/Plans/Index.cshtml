@model List<NexusServiceMarketingSystem.Models.Entities.Plan>
@{ ViewData["Title"] = "Plans"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Plans</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Plan</a>
</div>
@if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="q" value="@ViewBag.Search" class="form-control" placeholder="Search plans by name or description" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Search</button> <a asp-action="Index" class="btn btn-link">Clear</a></div>
</form>
<table class="table table-striped table-hover align-middle">
    <thead><tr><th>Name</th><th>Type</th><th>Kind</th><th>Validity</th><th>Price</th><th>Deposit</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.ConnectionType</td>
                <td>@p.Kind</td>
                <td>@p.ValidityMonths mo</td>
                <td>@p.Price.ToString("C")</td>
                <td>@p.SecurityDeposit.ToString("C")</td>
                <td>
                    @if (p.IsActive) { <span class="badge bg-success">Active</span> }
                    else { <span class="badge bg-secondary">Inactive</span> }
                </td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this plan permanently?');">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-muted">No plans match your search.</td></tr>
        }
    </tbody>
</table>
