@model NexusServiceMarketingSystem.Areas.Admin.Models.ProductPurchaseFormViewModel
<h1>Record received equipment purchase</h1><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="VendorId"></label><select asp-for="VendorId" asp-items="Model.Vendors" class="form-select"><option value="">Choose vendor</option></select><label asp-for="ProductId"></label><select asp-for="ProductId" asp-items="Model.Products" class="form-select"><option value="">Choose vendor product</option></select><label asp-for="Quantity"></label><input asp-for="Quantity" class="form-control"/><label asp-for="UnitPrice"></label><input asp-for="UnitPrice" class="form-control"/><label asp-for="AmountPaid"></label><input asp-for="AmountPaid" class="form-control"/><label asp-for="PurchaseDate"></label><input asp-for="PurchaseDate" class="form-control"/><label asp-for="SupplierReference"></label><input asp-for="SupplierReference" class="form-control"/><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control"></textarea><button class="btn btn-primary mt-3">Save purchase and add stock</button></form>
