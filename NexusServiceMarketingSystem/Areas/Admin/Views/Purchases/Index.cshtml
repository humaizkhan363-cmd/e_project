@model IReadOnlyList<NexusServiceMarketingSystem.Models.Entities.ProductPurchase>
<h1>Equipment purchases</h1><p>Purchase receipts are recorded here and automatically increase product stock.</p><p><a class="btn btn-primary" asp-action="Create">Record purchase received</a></p>@if(TempData["StatusMessage"] is string s){<div class="alert alert-success">@s</div>}<table class="table"><thead><tr><th>Date</th><th>Vendor</th><th>Product</th><th>Qty</th><th>Unit cost</th><th>Total</th><th>Paid</th><th>Balance</th><th>Reference</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.PurchaseDate</td><td>@p.Vendor.Name</td><td>@p.Product.Name</td><td>@p.Quantity</td><td>@p.UnitPrice</td><td>@(p.Quantity*p.UnitPrice)</td><td>@p.AmountPaid</td><td>@(p.Quantity*p.UnitPrice-p.AmountPaid)</td><td>@p.SupplierReference</td></tr>}</tbody></table>
