@model List<NexusServiceMarketingSystem.Models.Entities.City>
@{
    ViewData["Title"] = "Cities";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Cities</h1>
    <a asp-action="Create" class="btn btn-primary">+ New City</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var city in Model)
        {
            <tr>
                <td>@city.Name</td>
                <td>@city.Code</td>
                <td>
                    @if (city.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td><a asp-action="Edit" asp-route-id="@city.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
            </tr>
        }
    </tbody>
</table>
