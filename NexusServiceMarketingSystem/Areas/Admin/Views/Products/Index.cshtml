@model List<NexusServiceMarketingSystem.Models.Entities.Product>
@{ ViewData["Title"] = "Products"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Product</a>
</div>
@if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
<table class="table table-striped table-hover align-middle">
    <thead><tr><th>SKU</th><th>Name</th><th>Category</th><th>Vendor</th><th>Stock</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Sku</td>
                <td>@p.Name</td>
                <td>@p.Category</td>
                <td>@p.Vendor.Name</td>
                <td>@p.StockQuantity @(p.StockQuantity <= p.ReorderLevel ? "(reorder!)" : "")</td>
                <td>
                    @if (p.IsActive) { <span class="badge bg-success">Active</span> }
                    else { <span class="badge bg-secondary">Inactive</span> }
                </td>
                <td><a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
            </tr>
        }
    </tbody>
</table>
