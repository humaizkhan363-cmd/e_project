@model NexusServiceMarketingSystem.Models.Entities.Customer
@{ ViewData["Title"] = "Customer Details"; }
<div class="d-flex justify-content-between align-items-start"><div><h1>@Model.FullName</h1><span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span></div><a asp-action="Index" class="btn btn-outline-secondary">Back to customers</a></div>
<dl class="row mt-3"><dt class="col-sm-3">Customer ID</dt><dd class="col-sm-9">@Model.Id</dd><dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.CustomerType @(Model.CompanyName is null ? "" : "— " + Model.CompanyName)</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.AddressLine, @Model.City.Name @Model.PostalCode</dd><dt class="col-sm-3">Login</dt><dd class="col-sm-9">@(Model.User?.Username ?? "No login")</dd><dt class="col-sm-3">Account created</dt><dd class="col-sm-9">@Model.CreatedAtUtc.ToString("yyyy-MM-dd")</dd></dl>
<h2 class="h4">Orders (@Model.Orders.Count)</h2><ul>@foreach(var order in Model.Orders.OrderByDescending(o => o.PlacedAtUtc)){<li><a asp-area="Admin" asp-controller="Operations" asp-action="Orders" asp-route-term="@order.OrderNumber">@order.OrderNumber</a> — @order.Status</li>}</ul>
<h2 class="h4">Connections (@Model.Connections.Count)</h2><ul>@foreach(var connection in Model.Connections.OrderBy(c => c.AccountId)){<li><a asp-area="Admin" asp-controller="Operations" asp-action="Search" asp-route-AccountId="@connection.AccountId">@connection.AccountId</a> — @connection.Status</li>}</ul>
<p><a asp-area="Customer" asp-controller="Documents" asp-action="Index" asp-route-customerId="@Model.Id">Customer documents</a></p>
