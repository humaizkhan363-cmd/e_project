@model List<NexusServiceMarketingSystem.Models.Entities.Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Customers</h1><a asp-action="Create" class="btn btn-primary">New customer</a></div>
@if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Name, email, phone, or customer ID"/></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button></div></form>
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>Customer</th><th>Contact</th><th>City</th><th>Orders</th><th>Connections</th><th>Login</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var customer in Model) { <tr><td>@customer.FullName <small class="text-muted">#@customer.Id</small></td><td>@customer.Phone<br/>@customer.Email</td><td>@customer.City.Name</td><td>@customer.Orders.Count</td><td>@customer.Connections.Count</td><td>@(customer.User?.Username ?? "—")</td><td><span class="badge @(customer.IsActive ? "bg-success" : "bg-secondary")">@(customer.IsActive ? "Active" : "Inactive")</span></td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary">Details</a> <form asp-action="ToggleStatus" asp-route-id="@customer.Id" method="post" class="d-inline"><button class="btn btn-sm @(customer.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(customer.IsActive ? "Deactivate" : "Activate")</button></form></td></tr> }
</tbody></table></div>
