@model NexusServiceMarketingSystem.Models.Workflows.FeasibilityCheckFormViewModel
<h1>Record @Model.CheckType feasibility</h1><p>@Model.OrderNumber — @Model.CustomerName</p><form asp-action="Check" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"/><input asp-for="CheckType" type="hidden"/><input asp-for="OrderNumber" type="hidden"/><input asp-for="CustomerName" type="hidden"/>
<label asp-for="DistanceKm"></label><input asp-for="DistanceKm" class="form-control" min="0" step="0.1"/>
@if(Model.CheckType==NexusServiceMarketingSystem.Models.Enums.FeasibilityCheckType.Internet){<label asp-for="ServerAvailable"></label><select asp-for="ServerAvailable" class="form-select"><option value="">Select</option><option value="true">Available</option><option value="false">Unavailable</option></select>}
<label>Result</label><select asp-for="Status" class="form-select"><option value="2">Feasible</option><option value="3">Not feasible</option></select><label asp-for="Remarks"></label><textarea asp-for="Remarks" class="form-control"></textarea><button class="btn btn-primary mt-3">Save result</button></form>
