@model NexusServiceMarketingSystem.Areas.Customer.Controllers.ProfileForm
<h1>My profile</h1>@if(TempData["StatusMessage"] is string s){<div class="alert alert-success">@s</div>}<form asp-action="Profile" method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="FullName"></label><input asp-for="FullName" class="form-control"/><label asp-for="Email"></label><input asp-for="Email" class="form-control"/><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/><label asp-for="AddressLine"></label><input asp-for="AddressLine" class="form-control"/><label asp-for="PostalCode"></label><input asp-for="PostalCode" class="form-control"/><label asp-for="CityName"></label><input asp-for="CityName" class="form-control" readonly/><button class="btn btn-primary mt-3">Save</button></form>
