@model NexusServiceMarketingSystem.Models.Workflows.FeedbackFormViewModel
<h1>Feedback</h1>@if(TempData["StatusMessage"] is string s){<div class="alert alert-success">@s</div>}<form asp-action="Feedback" method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Rating"></label><select asp-for="Rating" class="form-select"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select><label asp-for="OrderId"></label><select asp-for="OrderId" asp-items="Model.Orders" class="form-select"><option value="">General</option></select><label asp-for="ConnectionId"></label><select asp-for="ConnectionId" asp-items="Model.Connections" class="form-select"><option value="">None</option></select><label asp-for="Comments"></label><textarea asp-for="Comments" class="form-control"></textarea><button class="btn btn-primary mt-3">Submit</button></form>
