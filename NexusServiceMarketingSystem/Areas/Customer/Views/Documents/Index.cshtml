@model NexusServiceMarketingSystem.Models.Workflows.CustomerDocumentFormViewModel
<h1>Customer documents — @Model.CustomerName</h1><p>Files are private and accessible only to this customer, Admin, and the retail shop handling the customer. PDF, PNG, or JPEG files up to 5 MB are accepted.</p>@if(TempData["StatusMessage"] is string s){<div class="alert alert-success">@s</div>}<form asp-action="Upload" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="CustomerId" type="hidden"/><label asp-for="DocumentType"></label><select asp-for="DocumentType" asp-items="Html.GetEnumSelectList<NexusServiceMarketingSystem.Models.Enums.CustomerDocumentType>()" class="form-select"><option value="">Choose document type</option></select><label asp-for="DocumentYear"></label><input asp-for="DocumentYear" class="form-control"/><label asp-for="File"></label><input asp-for="File" type="file" accept=".pdf,.png,.jpg,.jpeg" class="form-control"/><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control"></textarea><button class="btn btn-primary mt-3">Upload document</button></form><h2 class="mt-4">Filed documents</h2><ul>@foreach(var d in Model.Documents){<li>@d.Text <a asp-action="Download" asp-route-id="@d.Value">Download</a></li>}</ul>
